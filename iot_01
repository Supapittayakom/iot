```cpp
#include <TFT_eSPI.h>  // เรียกใช้ไลบรารีหน้าจอ
TFT_eSPI tft;          // สร้างตัวแปรควบคุมหน้าจอ

const int LED1 = A0;
const int LED2 = A1;

int level = 5;         // ความเร็วเริ่มต้น
bool ledState = false; // สถานะไฟ

unsigned long lastToggle = 0;
unsigned long lastStep = 0;

const int MAX_LEVEL = 10;
const int REPEAT_MS = 120;

// คำนวณความเร็ว
unsigned long getDelay() {
  return map(level, 1, 10, 700, 40);
}

// ตั้งค่าเริ่มต้น
void setup() {
  pinMode(LED1, OUTPUT);
  pinMode(LED2, OUTPUT);

  pinMode(WIO_5S_RIGHT, INPUT_PULLUP);
  pinMode(WIO_5S_LEFT, INPUT_PULLUP);

  tft.begin();
  tft.setRotation(3);
}

// ทำงานวนซ้ำ
void loop() {
  bool right = digitalRead(WIO_5S_RIGHT) == LOW;
  bool left = digitalRead(WIO_5S_LEFT) == LOW;

  // กดขวาเพิ่มความเร็ว กดซ้ายลดความเร็ว
  if ((right || left) && millis() - lastStep >= REPEAT_MS) {
    if (right && level < MAX_LEVEL) level++;
    if (left && level > 1) level--;

    lastStep = millis();
  }

  if (!right && !left) lastStep = 0;

  // สลับไฟสองดวง
  if (millis() - lastToggle >= getDelay()) {
    lastToggle = millis();
    ledState = !ledState;

    digitalWrite(LED1, ledState);
    digitalWrite(LED2, !ledState);
  }
}
